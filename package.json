{
  "name": "chakraui-excel-library-comparison",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lilpacy/chakraui-excel-library-comparison.git"
  },
  "homepage": "https://github.com/lilpacy/chakraui-excel-library-comparison",
  "bugs": {
    "url": "https://github.com/lilpacy/chakraui-excel-library-comparison/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:create": "wrangler d1 create chakraui-excel-library-comparison-db",
    "db:create:preview": "wrangler d1 create chakraui-excel-library-comparison-db-preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply chakraui-excel-library-comparison-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply chakraui-excel-library-comparison-db --remote",
    "db:migrate:preview": "wrangler d1 migrations apply chakraui-excel-library-comparison-db-preview --remote --env preview",
    "db:shell:local": "wrangler d1 execute chakraui-excel-library-comparison-db --local --command",
    "db:shell:prod": "wrangler d1 execute chakraui-excel-library-comparison-db --remote --command",
    "db:shell:preview": "wrangler d1 execute chakraui-excel-library-comparison-db-preview --remote --env preview --command",
    "db:export:local": "wrangler d1 export chakraui-excel-library-comparison-db --local --output=./database-local.sql",
    "db:export:prod": "wrangler d1 export chakraui-excel-library-comparison-db --remote --output=./database-prod.sql",
    "db:export:preview": "wrangler d1 export chakraui-excel-library-comparison-db-preview --remote --env preview --output=./database-preview.sql",
    "storage:create:cache": "wrangler r2 bucket create chakraui-excel-library-comparison-cache",
    "storage:create:cache:preview": "wrangler r2 bucket create chakraui-excel-library-comparison-cache-preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@handsontable/react-wrapper": "^17.0.1",
    "@opennextjs/cloudflare": "^1.14.7",
    "@tanstack/react-table": "^8.21.3",
    "ag-grid-community": "^35.3.0",
    "ag-grid-enterprise": "^35.3.0",
    "ag-grid-react": "^35.3.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.5",
    "handsontable": "^17.0.1",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "next": "^15.5.9",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-datasheet-grid": "^4.11.6",
    "react-dom": "19.1.0",
    "react-responsive-carousel": "^3.2.23",
    "sass": "^1.99.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.18",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.17",
    "better-sqlite3": "^12.6.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "happy-dom": "^20.3.0",
    "husky": "^9.1.7",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17",
    "wrangler": "^4.40.3"
  }
}

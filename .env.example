# Base URL
# Used for generating absolute URLs (e.g., in sitemap, Open Graph tags)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics (Optional)
# Get your Measurement ID from https://analytics.google.com
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Cloudflare Configuration
# These are configured in wrangler.jsonc. D1 uses --local for development,
# and R2 is used for the OpenNext incremental cache.
